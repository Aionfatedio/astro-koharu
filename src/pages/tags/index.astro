---
import PageIntro from '@components/common/PageIntro.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import TagItem from '@components/tag/TagItem.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getAllTags, getSortedPosts } from '@lib/content';
import { tierTags } from '@lib/content/index-tags';

const posts = await getSortedPosts();
const tags = tierTags(getAllTags(posts));
const mainTags = tags.filter(({ count }) => count > 1);
const singleTags = tags.filter(({ count }) => count === 1);
const stats = [
  { value: tags.length, label: '个标签' },
  ...(tags.length ? [{ value: tags[0].tag, label: '最常用', labelFirst: true }] : []),
];
---
<Layout articleTools={false} title={`标签 | ${siteConfig.title}`} description="所有文章标签">
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title="全部标签" />
    <HomeSider slot="sider" />
    <div class="index-surface shadow-box" data-tag-cloud>
      <PageIntro stats={stats}>
        <label class="tag-filter" slot="tools">
          <span class="sr-only">过滤标签</span>
          <input type="search" data-tag-filter placeholder="输入标签名称" autocomplete="off" />
        </label>
      </PageIntro>
      <div class="tag-cloud-list">{mainTags.map((tag) => <TagItem {...tag} />)}</div>
      {singleTags.length > 0 && <details class="tag-singletons">
        <summary>还有 {singleTags.length} 个只出现过一次的标签</summary>
        <div class="tag-cloud-list">{singleTags.map((tag) => <TagItem {...tag} />)}</div>
      </details>}
      <p class="tag-empty text-muted-foreground" data-tag-empty role="status" aria-live="polite" hidden={tags.length > 0}>没有匹配的标签</p>
    </div>
  </TwoColumnLayout>
</Layout>
<script>
  import { setupTagFilter } from '@lib/tag-filter';
  setupTagFilter();
</script>
