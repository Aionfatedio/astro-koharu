---
import PageIntro from '@components/common/PageIntro.astro';
import PostYears from '@components/common/PostYears.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getSortedPosts, normalizeTag } from '@lib/content';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = new Set<string>();

  posts.forEach((post) => {
    const postTags = post.data.tags || [];
    postTags.forEach((tag) => {
      tags.add(normalizeTag(tag));
    });
  });

  return Array.from(tags).map((tag) => ({
    params: { tag: normalizeTag(tag).replace(/\//g, '-') },
    props: {
      posts: posts.filter((post) => post.data.tags?.some((t) => normalizeTag(t) === tag)),
      tag,
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout articleTools={false} title={`标签:${tag} | ${siteConfig.title}`} description={`标签 ${tag} 下的所有文章`}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title={`包含标签"${tag}"的文章`} />
    <HomeSider slot="sider" />
    <div class="index-surface shadow-box">
      <PageIntro stats={[{ value: posts.length, label: '篇文章' }]} breadcrumbs={[{ label: '标签', href: '/tags' }, { label: tag }]} />
      <PostYears posts={posts} />
    </div>
  </TwoColumnLayout>
</Layout>
