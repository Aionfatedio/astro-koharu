---
import PageIntro from '@components/common/PageIntro.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import SeriesIssues from '@components/series/SeriesIssues.astro';
import SeriesCover from '@components/ui/cover/SeriesCover.astro';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { siteTimezone } from '@lib/config/site';
import type { FeaturedSeriesItem } from '@lib/config/types';
import { getEnabledSeries, getPostsByCategoryName } from '@lib/content';
import { toPostCardDataList } from '@lib/content/transforms';
import type { GetStaticPaths } from 'astro';
import { formatInTimeZone } from 'date-fns-tz';

export const getStaticPaths: GetStaticPaths = async () => {
  // Reserved slug validation is performed in normalizeFeaturedSeries (site-config.ts)
  // at config load time, so all enabled series here are guaranteed to have valid slugs
  const enabledSeries = getEnabledSeries();

  return enabledSeries.map((series) => ({
    params: { seriesSlug: series.slug },
    props: { series },
  }));
};

interface Props {
  series: FeaturedSeriesItem;
}

const { series } = Astro.props;

// Get all posts for this series (transform to card data)
const seriesPosts = toPostCardDataList(await getPostsByCategoryName(series.categoryName));

const pageTitle = series.fullName ?? series.label ?? series.categoryName;
// Oldest–newest year of the run; one year when the series has not crossed a new year yet.
const span = [
  ...new Set([seriesPosts.at(-1), seriesPosts[0]].map((post) => post && formatInTimeZone(post.date, siteTimezone, 'yyyy'))),
];
const stats = [{ value: seriesPosts.length, label: '期' }, ...(span[0] ? [{ value: span.join('–'), label: '年' }] : [])];
---

<Layout articleTools={false} title={`${pageTitle} | ${siteConfig.title}`} description={series.description?.slice(0, 160)}>
  <TwoColumnLayout showPostFooter={false}>
    <SeriesCover slot="cover" series={series} />
    <HomeSider slot="sider" />
    <div class="index-surface shadow-box">
      <PageIntro stats={stats} />
      <SeriesIssues posts={seriesPosts} />
    </div>
  </TwoColumnLayout>
</Layout>
