---
import CategoryList from '@components/category/CategoryList.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getCategoryLinks, getCategoryList, getSortedPosts } from '@lib/content';

const { categories, countMap } = await getCategoryList();
const links = getCategoryLinks(categories);
const postCount = (await getSortedPosts()).length;
---

<Layout articleTools={false} title={`全部分类 | ${seoConfig.title}`}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title="全部分类" />
    <HomeSider slot="sider" />
    <CategoryList categories={categories} countMap={countMap} totalCount={links.length} postCount={postCount} />
  </TwoColumnLayout>
</Layout>
