---
import FriendsRedirect from '@components/friends/FriendsRedirect';
// 友情链接功能暂时停用，以下组件保留代码、暂时注释，恢复友链功能时取消注释即可：
// import FriendsContent from '@components/friends/FriendsContent.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';

const title = `友情链接 | ${siteConfig.title}`;
const description = '我的小伙伴们，欢迎加友链～';
---

<Layout title={title} description={description}>
  <TwoColumnLayout>
    <Cover compact slot="cover" title="友情链接" />
    <HomeSider slot="sider" />
    <div
      class={`bg-gradient-start shadow-box tablet:shadow-none flex flex-col gap-10 overflow-clip ${CONTENT_PADDING.standard}`}
    >
      {/* 友情链接功能暂时停用：访问者将在 5 秒后重定向回主页 */}
      <FriendsRedirect client:load />

      {/* 原友链内容（友链网格 / 申请友链卡片 / 评论区）暂时停用，恢复时取消以下注释：
      <FriendsContent />
      */}
    </div>
  </TwoColumnLayout>
</Layout>
