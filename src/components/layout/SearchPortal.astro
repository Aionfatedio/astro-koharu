---
/**
 * SearchPortal Component
 *
 * Provides the Pagefind search UI that gets portal'd into SearchDialog.
 * Listens for search-dialog-open/close events to move the search component.
 */
import Search from 'astro-pagefind/components/Search';
---

<!-- Search Component - will be portal'd into dialog -->
<div id="search-component-portal">
  <Search
    id="search-for-dialog"
    className="pagefind-ui"
    uiOptions={{
      showImages: false,
      resetStyles: false,
      highlightParam: 'q',
      translations: {
        placeholder: '请输入关键词搜索',
        clear_search: '清空',
        load_more: '加载更多结果',
        search_label: '搜索本站',
        filters_label: '过滤器',
        zero_results: '没有找到结果',
        many_results: '[COUNT] 个结果',
        one_result: '[COUNT] 个结果',
        alt_search: '没有找到结果。显示 [DIFFERENT_TERM] 的结果',
        search_suggestion: '没有找到结果。尝试以下搜索：',
        searching: '搜索 [SEARCH_TERM]...',
      },
    }}
  />
</div>

<script>
  import {
    applyPagefindSearchQuery,
    PAGEFIND_SEARCH_INPUT_SELECTOR,
    type PagefindSearchSession,
    readPagefindSearchSession,
    SEARCH_DIALOG_SCROLL_AREA_ID,
    updatePagefindSearchSession,
  } from '@lib/pagefind-search-session';

  function getSearchComponent(): HTMLElement | null {
    return document.getElementById('search-for-dialog');
  }

  function getSearchInput(searchComponent: HTMLElement): HTMLInputElement | null {
    return searchComponent.querySelector<HTMLInputElement>(PAGEFIND_SEARCH_INPUT_SELECTOR);
  }

  function getScrollArea(): HTMLElement | null {
    return document.getElementById(SEARCH_DIALOG_SCROLL_AREA_ID);
  }

  function persistSearchSession() {
    const searchComponent = getSearchComponent();
    const scrollArea = getScrollArea();
    const patch: Partial<PagefindSearchSession> = {};

    if (searchComponent) {
      const input = getSearchInput(searchComponent);

      if (input) {
        patch.query = input.value;
      }
    }

    if (scrollArea) {
      patch.scrollTop = scrollArea.scrollTop;
    }

    if (Object.keys(patch).length > 0) {
      updatePagefindSearchSession(patch);
    }
  }

  function restoreSearchQuery(searchComponent: HTMLElement) {
    const input = getSearchInput(searchComponent);
    if (!input) return;

    const { query } = readPagefindSearchSession();
    applyPagefindSearchQuery(input, query);
  }

  function restoreScrollPosition() {
    const scrollArea = getScrollArea();
    if (!scrollArea) return;

    const { scrollTop } = readPagefindSearchSession();
    scrollArea.scrollTop = scrollTop;
  }

  let inputController: AbortController | null = null;
  let scrollController: AbortController | null = null;
  let resultObserver: MutationObserver | null = null;

  function bindInputPersistence(searchComponent: HTMLElement) {
    const input = getSearchInput(searchComponent);
    if (!input) return;

    inputController?.abort();
    inputController = new AbortController();

    input.addEventListener(
      'input',
      () => {
        const scrollArea = getScrollArea();
        if (scrollArea) {
          scrollArea.scrollTop = 0;
        }
        updatePagefindSearchSession({ query: input.value, scrollTop: 0 });
      },
      { signal: inputController.signal },
    );

    searchComponent.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (!target.closest('.pagefind-ui__search-clear')) return;

        queueMicrotask(() => {
          persistSearchSession();
        });
      },
      { signal: inputController.signal },
    );
  }

  function bindScrollPersistence() {
    const scrollArea = getScrollArea();
    if (!scrollArea) return;

    scrollController?.abort();
    scrollController = new AbortController();

    scrollArea.addEventListener(
      'scroll',
      () => {
        updatePagefindSearchSession({ scrollTop: scrollArea.scrollTop });
      },
      { passive: true, signal: scrollController.signal },
    );
  }

  function bindResultObserver(searchComponent: HTMLElement) {
    resultObserver?.disconnect();
    resultObserver = new MutationObserver(() => {
      restoreScrollPosition();
    });
    resultObserver.observe(searchComponent, { childList: true, subtree: true });
  }

  function bindSearchSession(searchComponent: HTMLElement) {
    bindInputPersistence(searchComponent);
    bindScrollPersistence();
    bindResultObserver(searchComponent);
  }

  function unbindSearchSession() {
    inputController?.abort();
    inputController = null;
    scrollController?.abort();
    scrollController = null;
    resultObserver?.disconnect();
    resultObserver = null;
  }

  function moveSearchToDialog() {
    const dialogContainer = document.getElementById('search-dialog-container');
    const searchPortal = document.getElementById('search-component-portal');
    const searchComponent = getSearchComponent();

    if (!dialogContainer || !searchPortal || !searchComponent) return;

    // Check if search component is already in the dialog
    if (!dialogContainer.contains(searchComponent)) {
      // Move search component to dialog
      dialogContainer.appendChild(searchComponent);
    }

    restoreSearchQuery(searchComponent);
    bindSearchSession(searchComponent);
    restoreScrollPosition();
  }

  function moveSearchBack() {
    persistSearchSession();
    unbindSearchSession();

    const searchComponent = getSearchComponent();
    const searchPortal = document.getElementById('search-component-portal');

    if (!searchComponent || !searchPortal) return;

    // Move search component back to portal if it's not already there
    if (!searchPortal.contains(searchComponent)) {
      searchPortal.appendChild(searchComponent);
    }
  }

  function handleDialogOpen() {
    // Small delay to ensure dialog container is rendered
    requestAnimationFrame(() => {
      moveSearchToDialog();
      restoreScrollPosition();
    });
  }

  function handleDialogClose() {
    // Move search back immediately before DOM is removed
    moveSearchBack();
  }

  let initialized = false;

  function initSearchPortal() {
    if (initialized) return;
    initialized = true;

    window.addEventListener('search-dialog-open', handleDialogOpen);
    window.addEventListener('search-dialog-close', handleDialogClose);

    const searchComponent = getSearchComponent();
    if (searchComponent) {
      restoreSearchQuery(searchComponent);
      bindInputPersistence(searchComponent);
    }
  }

  function cleanupSearchPortal() {
    if (!initialized) return;

    persistSearchSession();
    unbindSearchSession();
    window.removeEventListener('search-dialog-open', handleDialogOpen);
    window.removeEventListener('search-dialog-close', handleDialogClose);
    initialized = false;
  }

  // Initialize immediately if DOM is ready
  if (document.readyState !== 'loading') {
    initSearchPortal();
  }

  document.addEventListener('astro:page-load', initSearchPortal);
  document.addEventListener('astro:before-swap', cleanupSearchPortal);
</script>

<style>
  /* Hide the portal container */
  #search-component-portal {
    display: none;
    position: absolute;
    pointer-events: none;
    visibility: hidden;
  }
</style>
<style is:global>
  /* Ensure search is visible when in dialog */
  #search-dialog-container #search-for-dialog {
    display: block !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }
</style>
