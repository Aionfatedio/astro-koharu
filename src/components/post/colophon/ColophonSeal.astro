---
import type { ColophonItem } from '@lib/content/colophon';
import { colophonSealRows } from '@lib/content/colophon-view';
import { displayDate } from '@lib/date';

interface Props {
  /** Seal-placed marks. */
  items: ColophonItem[];
  date: Date;
}
const { items, date } = Astro.props;
const rows = colophonSealRows(items);
const day = displayDate.date(date);
---
{
  rows.length > 0 && (
    <div class="colophon-seal" role="note" aria-label="落款">
      {rows.map((row) => (
        <p>
          {row.label && <span class="colophon-seal-group">{row.label}</span>}
          {row.marks.map((mark, index) => (
            <>
              {index > 0 && ' · '}
              <span>
                {mark.label}
                {mark.note && <span class="colophon-seal-note"> — {mark.note}</span>}
              </span>
            </>
          ))}
        </p>
      ))}
      <p class="colophon-seal-date">
        <time datetime={day}>{day}</time>
      </p>
    </div>
  )
}
