---
import PageIntro from '@components/common/PageIntro.astro';
import type { Category } from '@lib/content';
import { PETAL_MASK } from '@lib/sakura/petal';

interface Props {
  categories: Category[];
  countMap: Record<string, number>;
  totalCount: number;
  postCount: number;
}
const { categories, countMap, totalCount, postCount } = Astro.props;
---
<div class="index-surface shadow-box" style={{ '--petal-mask': PETAL_MASK }}>
  <PageIntro stats={[{ value: totalCount, label: '个分类' }, { value: postCount, label: '篇文章' }]} />
  <ol class="category-toc">
    {categories.map((category) => <li class="motion-reveal">
      <a class="category-toc-head" href={`/categories/${category.link}`}>
        <span class="category-toc-name">{category.name}</span>
        <span class="category-toc-leader" aria-hidden="true"></span>
        <span class="category-toc-count">{countMap[category.link]}</span>
      </a>
      {!!category.children?.length && <ul class="category-toc-children">
        {category.children.map((child) => <li>
          <a href={`/categories/${child.link}`}>{child.name}<sup>{countMap[child.link]}</sup></a>
          {!!child.children?.length && <span class="category-toc-grand">
            {child.children.map((grandchild) => <a href={`/categories/${grandchild.link}`}>{grandchild.name}<sup>{countMap[grandchild.link]}</sup></a>)}
          </span>}
        </li>)}
      </ul>}
    </li>)}
  </ol>
</div>
