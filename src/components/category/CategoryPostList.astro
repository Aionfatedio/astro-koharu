---
import PageIntro from '@components/common/PageIntro.astro';
import PostYears from '@components/common/PostYears.astro';
import { buildCategoryPath, type Category, getCategoryPaths, getPostsByCategoryPath } from '@lib/content';
import type { BlogPost } from 'types/blog';

interface Props {
  category: Category | null;
}
const { category } = Astro.props;
const path = category?.path ?? [];
const posts = category ? await getPostsByCategoryPath(path) : [];
// A post can belong to several branches; keep every matching path under the current category.
const childBranchesOf = (post: BlogPost) =>
  getCategoryPaths(post.data.categories)
    .filter((ancestry) => ancestry.length > path.length && path.every((name, index) => ancestry[index] === name))
    .map((ancestry) => ancestry[path.length]);
const children = await Promise.all(
  (category?.children ?? []).map(async (child) => ({
    category: child,
    count: (await getPostsByCategoryPath(child.path)).length,
  })),
);
const breadcrumbs = [
  { label: '分类', href: '/categories' },
  ...path.map((name, index) => ({
    label: name,
    href: index === path.length - 1 ? undefined : buildCategoryPath(path.slice(0, index + 1)),
  })),
];
---
<div class="index-surface shadow-box" data-category-filter-root>
  <PageIntro stats={[{ value: posts.length, label: '篇文章' }]} breadcrumbs={breadcrumbs}>
    {children.length > 0 && <div class="index-tabs" slot="tools" role="group" aria-label="子分类">
      <button type="button" data-category-filter="" aria-pressed="true">全部<sup>{posts.length}</sup></button>
      {children.map(({ category: child, count }) => <button type="button" data-category-filter={child.name} aria-pressed="false">{child.name}<sup>{count}</sup></button>)}
    </div>}
  </PageIntro>
  <PostYears posts={posts} showCategory={children.length > 0} filterKeysOf={childBranchesOf} />
</div>
<script>
  import { setupCategoryFilter } from '@lib/category-filter';
  setupCategoryFilter();
</script>
