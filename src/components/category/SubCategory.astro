---
import type { Category } from '@lib/content';
import CategoryTitle from './CategoryTitle.astro';

interface Props {
  category: Category;
  countMap: Record<string, number>;
}

const { category, countMap } = Astro.props;
const hasChildren = (category.children?.length ?? 0) > 0;
---

<CategoryTitle
  title={category.name}
  count={countMap[category.link]}
  href={`/categories/${category.link}`}
  level="h3"
/>
{
  hasChildren && (
    <div class="category-second-level-container flex flex-col">
      {category.children?.map((grandChild) => (
        <p class="shoka-decoration-circle relative px-7.5 py-2 text-base/9 text-primary hover:text-blue">
          <a href={`/categories/${grandChild.link}`} class="dashed-border">
            {grandChild.name}
          </a>
          <span class="text-sm text-muted-foreground">({countMap[grandChild.link] ?? 0})</span>
        </p>
      ))}
    </div>
  )
}
