---
import { getPostLastCategory } from '@lib/content';
import { displayDate } from '@lib/date';
import { encodeSlug, getPostSlug } from '@lib/route';
import type { BlogPost } from 'types/blog';

interface Props {
  post: BlogPost;
  showCategory?: boolean;
  id?: string;
}
const { post, showCategory = true, id } = Astro.props;
const date = displayDate.date(post.data.date);
const category = getPostLastCategory(post);
---
<li class="post-row" id={id} tabindex={id ? -1 : undefined}>
  <time datetime={date}>{date.slice(5)}</time>
  <a class="post-row-title" href={`/post/${encodeSlug(getPostSlug(post))}`}>{post.data.title}</a>
  {showCategory && category.link && <a class="post-row-category" href={category.link}>{category.name}</a>}
</li>
