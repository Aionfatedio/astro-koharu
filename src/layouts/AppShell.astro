---
/** Body-level chrome: the page frame plus every globally mounted island. */

import type { HomeSiderType } from '@constants/enum';
import type { BlogPost } from 'types/blog';
import type { ArtistProfile } from '@/types/artist';

interface Props {
  post?: BlogPost;
  siderType?: HomeSiderType;
  isPostPage: boolean;
  articleTools?: boolean;
  artistProfile?: ArtistProfile | null;
}

import AnnouncementProvider from '@components/announcement/AnnouncementProvider.astro';
import GlobalBGMPlayer from '@components/bgm/GlobalBGMPlayer';
import ChristmasEffects from '@components/christmas/ChristmasEffects.astro';
import CodePenEmbed from '@components/embed/CodePenEmbed.astro';
import FloatingGroup from '@components/layout/FloatingGroup';
import Header from '@components/layout/Header.astro';
import MobileDrawer from '@components/layout/MobileDrawer.astro';
import SearchDialog from '@components/layout/SearchDialog';
import SearchPortal from '@components/layout/SearchPortal.astro';
import ArticleViewers from '@components/markdown/ArticleViewers';
import SettingsPanel from '@components/settings/SettingsPanel';
import { Toaster } from '@components/ui/sonner';
import { bgmConfig } from '@constants/site-config';

const { post, siderType, isPostPage, artistProfile, articleTools = true } = Astro.props;
---

<ChristmasEffects transition:persist="christmas-snowfall" />
<div class="flex min-h-screen flex-col text-black dark:text-white">
  <Header isPostPage={isPostPage} tocNumbering={post?.data.tocNumbering ?? true} />
  <main class="relative flex grow flex-col gap-4">
    <slot />
  </main>
  {bgmConfig.enabled && bgmConfig.audio.length > 0 && (
    <div transition:persist="global-bgm">
      <GlobalBGMPlayer client:only="react" audioGroups={bgmConfig.audio} metingApi={bgmConfig.metingApi} />
    </div>
  )}
  <FloatingGroup client:only="react" />
  <SettingsPanel client:idle />
  <MobileDrawer type={siderType} post={post} artistProfile={artistProfile} />
  <SearchDialog client:idle />
  <SearchPortal />
  {articleTools && <div data-article-viewers><ArticleViewers client:idle /></div>}
  <Toaster client:idle />
  <AnnouncementProvider />
  <CodePenEmbed />
</div>

<script>
  import { motionConfig } from '@constants/site-config';
  import { setupArrivalRender } from '@lib/arrival-render';
  import { setupHeaderContinuity } from '@lib/header-continuity';
  import { setupMorphTransitions } from '@lib/morph-transitions';
  import { setupPetalBurst } from '@lib/sakura/petal-burst';
  import { setupScrollReveal } from '@lib/scroll-reveal';
  import { setupScrollbarActivity } from '@lib/scrollbar-activity';

  setupMorphTransitions();
  setupHeaderContinuity();
  setupArrivalRender();
  setupScrollReveal();
  setupScrollbarActivity();
  if (motionConfig.clickBurst) setupPetalBurst();
</script>
